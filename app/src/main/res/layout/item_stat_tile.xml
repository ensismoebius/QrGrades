<?xml version="1.0" encoding="utf-8"?>
<!-- A big number with a caption under it; two of them share a row (weight 1 each). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:layout_weight="1"
    android:background="@drawable/bg_tile"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <TextView
        android:id="@+id/tileValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.QrGrades.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.QrGrades.LabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
